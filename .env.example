# Copier ce fichier en .env et renseigner les vraies clés :
#   cp .env.example .env

# Obligatoire pour `pac discover` (Google Cloud Console -> Places API (New))
GOOGLE_MAPS_API_KEY=

# Obligatoire pour `pac score` (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optionnel -- valeurs par défaut définies dans src/pac/config.py
# OPENROUTER_MODEL=~deepseek/deepseek-v4-flash-latest
# OPENROUTER_VERIFY_MODEL=anthropic/claude-sonnet-4.5
# MAX_REVIEWS_PER_PLACE=500
# WORKERS=8
# SCORE_WORKERS=8
